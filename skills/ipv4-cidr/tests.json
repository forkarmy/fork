[
  {
    "name": "slash-24 host bits cleared and broadcast is inside",
    "input": { "address": "192.168.1.5/24", "contains": "192.168.1.255" },
    "expect": {
      "valid": true,
      "address": "192.168.1.5",
      "prefix": 24,
      "integer": 3232235781,
      "octets": [192, 168, 1, 5],
      "network": "192.168.1.0",
      "broadcast": "192.168.1.255",
      "netmask": "255.255.255.0",
      "wildcard": "0.0.0.255",
      "first_host": "192.168.1.1",
      "last_host": "192.168.1.254",
      "host_count": 254,
      "total_addresses": 256,
      "network_cidr": "192.168.1.0/24",
      "is_network_address": false,
      "contains": true
    },
    "match": "equal"
  },
  {
    "name": "slash-16 loopback bounds from ip-address tests",
    "input": { "address": "127.0.0.1/16" },
    "expect": {
      "valid": true,
      "address": "127.0.0.1",
      "prefix": 16,
      "integer": 2130706433,
      "octets": [127, 0, 0, 1],
      "network": "127.0.0.0",
      "broadcast": "127.0.255.255",
      "netmask": "255.255.0.0",
      "wildcard": "0.0.255.255",
      "first_host": "127.0.0.1",
      "last_host": "127.0.255.254",
      "host_count": 65534,
      "total_addresses": 65536,
      "network_cidr": "127.0.0.0/16",
      "is_network_address": false,
      "contains": null
    },
    "match": "equal"
  },
  {
    "name": "fromInteger 432432423 is 25.198.101.39",
    "input": { "integer": 432432423 },
