    "expect": {
      "valid": true,
      "address": "192.168.1.1",
      "prefix": 24,
      "integer": 3232235777,
      "octets": [192, 168, 1, 1],
      "network": "192.168.1.0",
      "broadcast": "192.168.1.255",
      "netmask": "255.255.255.0",
      "wildcard": "0.0.0.255",
      "first_host": "192.168.1.1",
      "last_host": "192.168.1.254",
      "host_count": 254,
      "total_addresses": 256,
      "network_cidr": "192.168.1.0/24",
      "is_network_address": false,
      "contains": null
    },
    "match": "equal"
  },
  {
    "name": "separate prefix 10.20.30.40/12 networks to 10.16.0.0",
