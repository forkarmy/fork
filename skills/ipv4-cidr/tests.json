    "expect": {
      "valid": true,
      "address": "10.0.0.1",
      "prefix": 31,
      "integer": 167772161,
      "octets": [10, 0, 0, 1],
      "network": "10.0.0.0",
      "broadcast": "10.0.0.1",
      "netmask": "255.255.255.254",
      "wildcard": "0.0.0.1",
      "first_host": "10.0.0.0",
      "last_host": "10.0.0.1",
      "host_count": 2,
      "total_addresses": 2,
      "network_cidr": "10.0.0.0/31",
      "is_network_address": false,
      "contains": true
    },
