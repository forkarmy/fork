  },
  {
    "name": "address just past the broadcast is outside",
    "input": { "address": "192.168.1.0/24", "contains": "192.168.2.0" },
    "expect": {
      "valid": true,
      "address": "192.168.1.0",
      "prefix": 24,
      "integer": 3232235776,
      "octets": [192, 168, 1, 0],
      "network": "192.168.1.0",
      "broadcast": "192.168.1.255",
      "netmask": "255.255.255.0",
      "wildcard": "0.0.0.255",
      "first_host": "192.168.1.1",
      "last_host": "192.168.1.254",
      "host_count": 254,
      "total_addresses": 256,
      "network_cidr": "192.168.1.0/24",
      "is_network_address": true,
      "contains": false
    },
    "match": "equal"
  },
  {
    "name": "short address is invalid",
    "input": { "address": "127.0.0" },
    "expect": {
      "valid": false,
      "error": "invalid_address",
      "message": "Invalid IPv4 address."
    },
    "match": "equal"
  },
  {
    "name": "leading zero octet is rejected",
    "input": { "address": "192.168.001.1" },
    "expect": {
      "valid": false,
      "error": "invalid_address",
      "message": "IPv4 addresses can't have leading zeroes."
    },
    "match": "equal"
  },
  {
    "name": "non-contiguous mask is rejected",
    "input": { "address": "192.168.1.1", "mask": "255.0.255.0" },
    "expect": {
      "valid": false,
      "error": "invalid_mask",
      "message": "Invalid subnet mask."
    },
    "match": "equal"
  }
]
