      "valid": true,
      "address": "25.198.101.39",
      "prefix": 32,
      "integer": 432432423,
      "octets": [25, 198, 101, 39],
      "network": "25.198.101.39",
      "broadcast": "25.198.101.39",
      "netmask": "255.255.255.255",
      "wildcard": "0.0.0.0",
      "first_host": "25.198.101.39",
      "last_host": "25.198.101.39",
      "host_count": 1,
      "total_addresses": 1,
      "network_cidr": "25.198.101.39/32",
      "is_network_address": true,
      "contains": null
    },
    "match": "equal"
  },
  {
    "name": "issue 39 network form 205.65.224.110/29",
    "input": { "address": "205.65.224.110/29" },
    "expect": {
      "valid": true,
      "address": "205.65.224.110",
      "prefix": 29,
      "integer": 3443646574,
      "octets": [205, 65, 224, 110],
      "network": "205.65.224.104",
      "broadcast": "205.65.224.111",
      "netmask": "255.255.255.248",
      "wildcard": "0.0.0.7",
      "first_host": "205.65.224.105",
      "last_host": "205.65.224.110",
      "host_count": 6,
      "total_addresses": 8,
      "network_cidr": "205.65.224.104/29",
      "is_network_address": false,
      "contains": null
    },
    "match": "equal"
  },
  {
    "name": "dotted mask 255.255.255.0 is a /24",
