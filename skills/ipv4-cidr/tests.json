      "octets": [10, 0, 0, 1],
      "network": "0.0.0.0",
      "broadcast": "255.255.255.255",
      "netmask": "0.0.0.0",
      "wildcard": "255.255.255.255",
      "first_host": "0.0.0.1",
      "last_host": "255.255.255.254",
      "host_count": 4294967294,
      "total_addresses": 4294967296,
      "network_cidr": "0.0.0.0/0",
      "is_network_address": false,
      "contains": null
